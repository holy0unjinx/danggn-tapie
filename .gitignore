# 의존성과 빌드 결과
node_modules/
.next/
.next-build/
.next-dev/
.next-prod/

# 브라우저로 저장한 원본 당근 페이지와 그 리소스 폴더.
# scripts/extract-snapshot.py 로 data/ 와 public/ 을 다시 만들 때만 쓰고,
# 앱 실행에는 필요하지 않다. 두 세트 합쳐 약 16MB이고 원본 사이트의 저작물이다.
/*.html
/*_files/

# 사용자가 만든 데이터. 계정·채팅·올린 글·사진은 저장소에 넣지 않는다.
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/user-articles.json
data/users.json
data/chats.json
data/session-secret.json
data/uploads/

# 로그와 환경 파일
*.log
npm-debug.log*
.env
.env.*

# 편집기와 운영체제가 남기는 파일
.vscode/
.idea/
.DS_Store
Thumbs.db
